# Copy to .env.local for development. Production values go in the hosting
# provider's secret store, never in the repository.

# Public site URL. Production: https://www.nseyagroup.com. Staging: its own URL.
SITE_URL=http://localhost:3000
# "production" only on the live site: enables indexing in robots.txt and domain redirects.
SITE_ENV=

# PostgreSQL for form records. If unset, records are written to ./storage/dev-db.json (development only).
DATABASE_URL=

# Private upload storage (S3-compatible bucket in London). Browsers upload straight to it
# with signed URLs. Unset in development: files go to UPLOAD_DIR on disk.
S3_BUCKET=
S3_REGION=eu-west-2
# Only for a non-AWS service, e.g. https://storage.googleapis.com for Google Cloud Storage
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Signs upload receipts. Long random string (falls back to SESSION_SECRET).
UPLOAD_SECRET=
UPLOAD_DIR=./storage/uploads
# Optional ClamAV REST scanner; until set, uploads are marked "pending" scan.
CLAMAV_URL=

# Transactional email (SMTP). If unset, emails are written to ./storage/outbox (development only).
SMTP_URL=
EMAIL_FROM="Nseya Groupe Construction <contact@nseyagroup.com>"

# Inboxes for each form route (section 6). Defaults: contact@ (enquiries and general), careers@ (people),
# suppliers@ (supply chain), justin@ (alerts), all @nseyagroup.com.
INBOX_GROUP=
INBOX_CONSULTANCY=
INBOX_ETABLIX=
INBOX_CONSTRUCTION=
INBOX_SUPPLY_CHAIN=
INBOX_PEOPLE=
INBOX_ALERTS=

# Cloudflare Turnstile (spam protection without a visual puzzle). If unset, only the honeypot runs.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Companies House public data API key (supplier application lookup). If unset, details are typed in.
COMPANIES_HOUSE_API_KEY=

# Signs supplier sign-in sessions and resume links. Long random string.
SESSION_SECRET=

# Protects /api/cron/daily (reminders, retention, CONSTRUX export).
CRON_SECRET=

# Analytics: Plausible (cookieless) loads without consent; GA4 only after consent.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
NEXT_PUBLIC_GA4_ID=

# Calendar booking link for diagnostic / intro calls
NEXT_PUBLIC_BOOKING_URL=

# Show vacancies and other content marked draft (preview/staging only)
SHOW_DRAFTS=
